{
  "name": "rzz-ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "rzz-ui": "./scripts/rzz-ui.mjs"
  },
  "files": [
    "scripts/rzz-ui.mjs",
    "scripts/add.mjs",
    "registry/",
    "dist/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:tokens": "node build-tokens.mjs",
    "add": "node scripts/add.mjs",
    "rzz-ui": "node scripts/rzz-ui.mjs",
    "docs:dev": "npx --yes serve . -p 4173",
    "check:primitives": "node scripts/check-no-primitives.mjs",
    "cleanup:legacy-ui": "node scripts/cleanup-legacy-ui.mjs",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:registry": "node scripts/validate-registry.mjs",
    "test": "npm run build:tokens && git diff --exit-code dist/ && npm run test:registry && npm run test:contrast && npm run check:primitives",
    "ci": "npm run build:tokens && npm run check:primitives"
  },
  "devDependencies": {
    "style-dictionary": "^5.0.0",
    "typescript": "^5.9.0"
  }
}
